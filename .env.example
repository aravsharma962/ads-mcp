# Is file ko copy karke `.env` naam do aur asli values bharo.
# `.env` GitHub par kabhi commit nahi hoti (.gitignore ignore karta hai).

# --- Solution A (local stdio, ek hi ad account) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_API_VERSION=v27.0

# --- Solution B (hosted, multi-tenant) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENC_KEY=
