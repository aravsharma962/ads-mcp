# Is file ko copy karke `.env` naam do aur asli values bharo.
# `.env` GitHub par kabhi commit nahi hoti (.gitignore ignore karta hai).

# --- Solution A (local stdio, ek hi ad account) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_API_VERSION=v27.0

# --- Solution B (hosted, multi-tenant) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENC_KEY=

# --- Admin panel (/admin) ---
# Strong password, kam se kam 16 characters (warna /admin band rahega). Yeh page saare tenants ke tokens control karta hai.
ADMIN_PASSWORD=
# Random 32+ characters (cookie signing ke liye).
ADMIN_SESSION_SECRET=
