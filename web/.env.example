# Copy to .env.local for local work; on Vercel add these under Project Settings -> Environment Variables.
# Never commit real values.

# Public by design (the Supabase anon key is safe in the browser; RLS protects the data).
# Same project URL as SUPABASE_URL in the hub. Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Base URL of the Python hub (Vercel project A), for example https://your-hub.vercel.app
HUB_URL=
# Random 32+ characters, IDENTICAL to HUB_SERVICE_SECRET in the hub project.
HUB_SERVICE_SECRET=

# AI assistant. AI_PROVIDER is "claude" (default) or "openai".
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=claude
AI_MODEL_CLAUDE=
AI_MODEL_OPENAI=
# Tokens (in + out) per agency per calendar month.
AI_MONTHLY_TOKEN_CAP=200000

# Public URL of this web app, no trailing slash. Used in the tracker snippet and invite links.
APP_URL=
